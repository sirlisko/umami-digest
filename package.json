{
  "name": "umami-digest",
  "version": "0.1.0",
  "private": true,
  "description": "Daily, weekly, and/or monthly analytics email digest for Umami Analytics v3+, sent via Resend on Cloudflare Worker cron triggers.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/sirlisko/umami-digest"
  },
  "scripts": {
    "predev": "node scripts/sync-crons.mjs",
    "dev": "wrangler dev --test-scheduled",
    "predeploy": "node scripts/sync-crons.mjs",
    "deploy": "wrangler deploy",
    "sync-crons": "node scripts/sync-crons.mjs",
    "tail": "wrangler tail",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260828.1",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0",
    "wrangler": "^4.127.1"
  }
}
