name = "umami-digest"
main = "src/index.ts"
compatibility_date = "2026-08-01"

[vars]
SITE_NAME = "example.com"
UMAMI_URL = "https://stats.example.com"
UMAMI_WEBSITE_ID = "your-website-uuid"
REPORT_TO = "you@example.com"
REPORT_FROM = "reports@example.com"
# How many top pages/referrers/browsers/devices/countries to list per digest.
REPORT_TOP_N = 5

# Which digests to send, and when (UTC). All periods share REPORT_TIME and run
# from one Cron Trigger; `npm run dev`/`deploy`/`sync-crons` regenerate
# [triggers].crons from these.
REPORT_PERIODS = ["daily", "weekly", "monthly"]
REPORT_TIME = "08:00"
REPORT_WEEKLY_DAY = "mon"   # sun-sat or 0-6; required if "weekly" is enabled
REPORT_MONTHLY_DAY = 1      # 1-31; required if "monthly" is enabled
