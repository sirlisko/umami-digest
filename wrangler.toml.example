name = "umami-digest"
main = "src/index.ts"
compatibility_date = "2026-08-01"

[vars]
SITE_NAME = "example.com"
UMAMI_URL = "https://stats.example.com"
UMAMI_WEBSITE_ID = "your-website-uuid"
REPORT_TO = "you@example.com"
REPORT_FROM = "reports@example.com"

# Pick which digests you want and when, in plain UTC time - no cron syntax.
# `npm run dev` / `npm run deploy` regenerate [triggers].crons from this
# automatically (also: `npm run sync-crons` to preview without deploying).
# Add or remove a line for each digest; comment one out to turn it off.
[vars.REPORT_TIMES]
# daily = "08:00"           # every day at 08:00 UTC
weekly = "mon 08:00"        # every Monday at 08:00 UTC
monthly = "1 08:00"         # the 1st of each month at 08:00 UTC
